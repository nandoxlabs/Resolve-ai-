generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  ADMIN
  USER
}

enum ComplaintStatus {
  NEW
  IN_TRIAGE
  RESOLVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Sentiment {
  NEGATIVE
  NEUTRAL
  POSITIVE
}

enum LegalRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ComplaintSource {
  MANUAL
  EMAIL
  WHATSAPP
  GOOGLE_REVIEW
  INSTAGRAM
  FACEBOOK
  WEBSITE
  VOICE
}


// ==========================================
// NEXTAUTH TABLES
// ==========================================

model Account {
  id                String  @id @default(cuid())

  userId            String

  type              String
  provider          String
  providerAccountId String

  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String? @db.Text

  session_state String?

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([provider, providerAccountId])
}


model Session {

  id String @id @default(cuid())

  sessionToken String @unique

  userId String

  expires DateTime


  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )
}



// ==========================================
// ORGANIZATION (COMPANY)
// ==========================================

model Organization {

  id String @id @default(cuid())

  name String


  users User[]

  complaints Complaint[]


  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}



// ==========================================
// USERS
// ==========================================

model User {

  id String @id @default(cuid())


  name String?

  email String? @unique

  emailVerified DateTime?

  image String?


  passwordHash String?


  role UserRole @default(USER)



  organizationId String?

  organization Organization?
    @relation(
      fields: [organizationId],
      references: [id]
    )



  accounts Account[]

  sessions Session[]



  complaints Complaint[]
    @relation("CreatedComplaints")



  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}



// ==========================================
// COMPLAINTS
// ==========================================

model Complaint {

  id String @id @default(cuid())


  ticketNumber String @unique


  title String


  description String @db.Text


  source ComplaintSource @default(MANUAL)


  status ComplaintStatus @default(NEW)


  priority Priority @default(MEDIUM)

  
  // NEW FIELDS FOR TASK 1
  
  /// Customer name or identifier
  customerName String?
  
  /// Customer contact information (email or phone)
  customerContact String?
  
  /// Department or category this complaint belongs to
  department String?
  
  /// Customer satisfaction score (1-10)
  satisfactionScore Int?
  
  /// Whether this is a duplicate of another complaint
  isDuplicate Boolean @default(false)
  
  /// Link to parent complaint if duplicate
  duplicateOfId String?
  
  /// Resolution notes or response provided to customer
  resolutionNotes String? @db.Text
  
  /// Expected resolution date
  expectedResolutionDate DateTime?
  
  /// Actual resolution date
  actualResolutionDate DateTime?
  
  /// Tags or labels for categorization
  tags String[]
  
  /// Whether complaint has legal implications
  hasLegalImplications Boolean @default(false)

  organizationId String?


  organization Organization?
    @relation(
      fields: [organizationId],
      references: [id]
    )



  createdById String


  createdBy User
    @relation(
      "CreatedComplaints",
      fields: [createdById],
      references: [id],
      onDelete: Cascade
    )



  aiAnalysis AIAnalysis?



  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt


  @@index([status])

  @@index([priority])

  @@index([source])
  
  @@index([isDuplicate])
  
  @@index([hasLegalImplications])
}



// ==========================================
// GEMINI AI ANALYSIS
// ==========================================

model AIAnalysis {

  id String @id @default(cuid())


  complaintId String @unique


  complaint Complaint
    @relation(
      fields: [complaintId],
      references: [id],
      onDelete: Cascade
    )


  modelName String?


  sentiment Sentiment @default(NEUTRAL)


  sentimentScore Float?


  rootCause String? @db.Text


  legalRiskLevel LegalRiskLevel @default(LOW)



  executiveSummary String? @db.Text


  suggestedResponse String? @db.Text


  confidenceScore Float?



  processingTimeMs Int?



  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}
